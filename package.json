{
  "name": "@amyaxy/dsh-prompt-boost",
  "version": "0.1.0",
  "type": "module",
  "description": "Prompt enhancement for the DSH Web GUI, with a selectable enhancement model in Settings",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amyaxy/dsh-prompt-boost.git"
  },
  "homepage": "https://github.com/amyaxy/dsh-prompt-boost#readme",
  "bugs": {
    "url": "https://github.com/amyaxy/dsh-prompt-boost/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "prompt",
    "prompt-engineering"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.0-rc.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
